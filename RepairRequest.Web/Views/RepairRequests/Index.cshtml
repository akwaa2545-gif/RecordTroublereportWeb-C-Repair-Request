@model IReadOnlyList<global::RepairRequest.Web.Models.RepairRequest>
@{
    ViewData["Title"] = "My repair requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>My repair requests</h1>
        <p class="text-muted mb-0">Track requests you have submitted.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">New request</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">You have not submitted any repair requests yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Request</th>
                    <th>Equipment</th>
                    <th>Location</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Submitted</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td><strong>@request.RequestNumber</strong><br /><span class="text-muted">@request.Title</span></td>
                    <td>@request.EquipmentCode</td>
                    <td>@request.Location</td>
                    <td>@request.Priority</td>
                    <td>@request.Status</td>
                    <td>@request.CreatedUtc.LocalDateTime.ToString("g")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
